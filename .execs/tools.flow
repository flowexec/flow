# yaml-language-server: $schema=https://flowexec.io/schemas/flowfile_schema.json
tags: [development, tools]
executables:
  - verb: install
    name: tools
    description: Install project Go tools
    tags: [go, cli]
    parallel:
      dir: //
      failFast: false
      maxThreads: 3
      # mockgen and govulncheck are pinned as tools in go.mod and run with `go tool`, so they
      # need no install. The tools below are kept out of go.mod because their dependency trees
      # would leak into the module graph of anything importing pkg/.
      execs:
        - cmd: |
            if ! command -v go &> /dev/null; then
              echo "Go is not installed. Please install Go first."
              exit 1
            fi
        - cmd: |
            # GOBIN is shared across repos, so a binary already on PATH may be another repo's
            # version. Reinstall whenever its module version differs from the pin.
            want=v1.3.0
            have=$(go version -m "$(command -v cobra-cli 2>/dev/null)" 2>/dev/null | awk '$1 == "mod" {print $3}')
            if [ "$have" != "$want" ]; then
              echo "Installing cobra-cli ${want} (found: ${have:-none})..."
              go install github.com/spf13/cobra-cli@${want}
            fi
        - cmd: |
            # Keep in sync with the goreleaser install in .github/workflows/release.yaml.
            want=v2.12.5
            have=$(go version -m "$(command -v goreleaser 2>/dev/null)" 2>/dev/null | awk '$1 == "mod" {print $3}')
            if [ "$have" != "$want" ]; then
              echo "Installing goreleaser ${want} (found: ${have:-none})..."
              go install github.com/goreleaser/goreleaser/v2@${want}
            fi
